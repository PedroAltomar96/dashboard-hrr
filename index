function nextMonth(m){return m.month===11?{year:m.year+1,month:0}:{year:m.year,month:m.month+1};}
function prevMonth(m){return m.month===0?{year:m.year-1,month:11}:{year:m.year,month:m.month-1};}

function navDrp(side,dir){
  if(side==='left'){
    drpLeftMonth=dir>0?nextMonth(drpLeftMonth):prevMonth(drpLeftMonth);
    // keep right always = left+1 or further
    const lNext=nextMonth(drpLeftMonth);
    if(drpRightMonth.year<lNext.year||(drpRightMonth.year===lNext.year&&drpRightMonth.month<lNext.month))
      drpRightMonth=lNext;
  } else {
    drpRightMonth=dir>0?nextMonth(drpRightMonth):prevMonth(drpRightMonth);
    const rPrev=prevMonth(drpRightMonth);
    if(drpLeftMonth.year>rPrev.year||(drpLeftMonth.year===rPrev.year&&drpLeftMonth.month>rPrev.month))
      drpLeftMonth=rPrev;
  }
  renderDrpCalendars();
}

function renderDrpCalendars(){
  renderCal('drp-cal-left',drpLeftMonth,'left');
  renderCal('drp-cal-right',drpRightMonth,'right');
  updateDrpDisplay();
}

function renderCal(id,{year,month},side){
  const cont=document.getElementById(id);
  const firstDay=new Date(year,month,1).getDay();
  const daysInMonth=new Date(year,month+1,0).getDate();
  const s=drpStart,e=drpEnd,p=drpPending,h=drpHover;

  let html=`<div class="drp-cal-header">
    <button onclick="event.stopPropagation();navDrp('${side}',-1)">‹</button>
    <span class="drp-cal-title">${PT_MONTHS[month]} ${year}</span>
    <button onclick="event.stopPropagation();navDrp('${side}',1)">›</button>
  </div>
  <div class="drp-weekdays">${PT_DAYS.map(d=>`<span>${d}</span>`).join('')}</div>
  <div class="drp-days">`;

  for(let i=0;i<firstDay;i++) html+=`<button class="drp-day drp-empty"></button>`;

  for(let d=1;d<=daysInMonth;d++){
    const dateStr=`${year}-${String(month+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`;
    let cls='drp-day';
    const rangeEnd=e||(p&&h&&h>p?h:null);
    const rangeStart=s||p;
    if(rangeStart&&rangeEnd){
      if(dateStr>rangeStart&&dateStr<rangeEnd) cls+=' drp-in-range';
    }
    if(dateStr===s||dateStr===p) cls+=' drp-start'+(rangeEnd&&dateStr<rangeEnd?' drp-in-range':'');
    if(dateStr===e) cls+=' drp-end'+(rangeStart&&dateStr>rangeStart?' drp-in-range':'');
    if(dateStr===s&&dateStr===e) cls+=' drp-start drp-end';
    html+=`<button class="${cls}" data-date="${dateStr}" onclick="event.stopPropagation();drpClickDay('${dateStr}')">${d}</button>`;
  }
  html+=`</div>`;
  cont.innerHTML=html;
}

function drpClickDay(dateStr){
  if(!drpPending){
    drpPending=dateStr;drpStart=null;drpEnd=null;
  } else {
    if(dateStr<=drpPending){drpStart=dateStr;drpEnd=drpPending;}
    else{drpStart=drpPending;drpEnd=dateStr;}
    drpPending=null;drpHover=null;
  }
  updateDayHighlights();
  updateDrpDisplay();
}

function drpHoverMove(e){
  if(!drpPending)return;
  const btn=e.target.closest('[data-date]');
  const d=btn?btn.dataset.date:null;
  if(d!==drpHover){drpHover=d;updateDayHighlights();updateDrpDisplay();}
}

function drpHoverLeave(){
  if(!drpPending)return;
  drpHover=null;updateDayHighlights();updateDrpDisplay();
}

function updateDayHighlights(){
  const p=drpPending,s=drpStart,e=drpEnd,h=drpHover;
  let rS,rE;
  if(s&&e){rS=s;rE=e;}
  else if(p&&h){rS=p<h?p:h;rE=p<h?h:p;}
  else if(p){rS=p;rE=null;}
  document.querySelectorAll('.drp-day[data-date]').forEach(btn=>{
    const d=btn.dataset.date;
    let cls='drp-day';
    if(rS&&rE&&d>rS&&d<rE)cls+=' drp-in-range';
    if(rS&&d===rS)cls+=(rE&&rS!==rE?' drp-start drp-in-range':' drp-start');
    if(rE&&d===rE)cls+=(rS&&rS!==rE?' drp-end drp-in-range':' drp-end');
    if(rS&&rE&&d===rS&&d===rE)cls='drp-day drp-start drp-end';
    btn.className=cls;
  });
}

function updateDrpDisplay(){
  const disp=document.getElementById('drp-range-display');
  if(drpPending) disp.innerHTML=`Início: <span>${fmtDate(drpPending)}</span> → selecione a data final`;
  else if(drpStart&&drpEnd) disp.innerHTML=`<span>${fmtDate(drpStart)}</span> → <span>${fmtDate(drpEnd)}</span>`;
  else disp.textContent='Clique para selecionar data inicial';
