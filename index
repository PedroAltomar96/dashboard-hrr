// Derive real year/month from DATA_STR (ignores MÊS/ANO columns which have entry errors)
function getDP(r){
  const d=r.DATA_STR;
  if(!d)return null;
  const y=d.slice(0,4),m=parseInt(d.slice(5,7))-1;
  return{ano:y,mes:MONTH_ORDER[m],abbr:MONTH_ABBR[m],key:d.slice(0,7)};
}

function normASA(v,mode){
  if(!v||!v.trim())return null;
  const s=v.trim().toUpperCase().replace(/\s+/g,'');
  // Parse base class and emergency flag
  let base=null,emerg=false;
  if(/^I(?!I|V)E?$/.test(s)||s==='IE'){base='I';emerg=s.includes('E');}
  else if(/^II(?!I)E?$/.test(s)||s==='IIE'){base='II';emerg=s.includes('E');}
  else if(/^IIIE?$/.test(s)||s==='IIIE'){base='III';emerg=s.includes('E');}
  else if(/^IVE?$/.test(s)){base='IV';emerg=s.includes('E');}
  else if(/^VE?$/.test(s)){base='V';emerg=s.includes('E');}
  if(!base)return null;
  if(mode==='consolidado')return'ASA '+base;
  return emerg?'ASA '+base+' E':'ASA '+base;
}

function normAnest(v,mode){
  if(!v||!v.trim())return null;
  const s=v.trim().toUpperCase().replace(/\s+/g,' ');
  // Detect primary techniques
  const hasGeral=s.includes('GER')&&!s.match(/^GER$/); // catches GERAL, GERALL, GRAL, GER
  const hasGeralFull=/GER(AL)?/.test(s);
  const hasRaqui=/RAQ?U?I+/.test(s);
  const hasSedacao=/SEDA[CÇ]/.test(s);
  const hasBloqueio=/BLO?Q/.test(s);
  const hasLocal=/LOCAL/.test(s);

  // ── Grouped mode ───────────────────────────────────────────
  if(mode==='grupo'){
    // Geral = anything that has GERAL as primary (not RAQUI primary)
    if(hasGeralFull&&!hasRaqui)return'Geral';
    if(hasRaqui&&hasSedacao)return'Raqui + Sedação';
    if(hasRaqui&&!hasSedacao)return'Raqui';
    if(hasSedacao&&(hasLocal||hasBloqueio))return'Sedação Combinada';
    if(hasSedacao)return'Sedação';
    if(hasLocal||hasBloqueio)return'Local / Bloqueio';
    // Fallback for short typos
    if(/^GER$|^GRAL$|^IGERAL$/.test(s))return'Geral';
    return'Outros';
  }

  // ── Detailed mode: normalize typos ─────────────────────────
  if(hasRaqui&&hasSedacao)return'Raqui + Sedação';
  if(hasRaqui&&hasGeralFull)return'Raqui + Geral';
  if(hasRaqui&&hasBloqueio)return'Raqui + Bloqueio';
  if(hasRaqui)return'Raqui';
  if(hasGeralFull&&hasBloqueio)return'Geral + Bloqueio';
  if(hasGeralFull&&hasLocal)return'Geral + Local';
  if(hasGeralFull&&hasSedacao)return'Geral + Sedação';
  // Pure Geral (includes EOT, TOT, IOT, INALATÓRIO, typos)
  if(hasGeralFull||/^GER$|^GRAL$|^IGERAL$/.test(s))return'Geral';
  if(hasSedacao&&hasLocal)return'Sedação + Local';
  if(hasSedacao&&hasBloqueio)return'Sedação + Bloqueio';
  if(hasSedacao)return'Sedação';
  if(hasLocal)return'Local';
  if(hasBloqueio)return'Bloqueio';
  return null;
}

