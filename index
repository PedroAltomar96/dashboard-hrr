function renderAnestesia(d){
  d=d||getActiveData();
  var _anEl=document.getElementById('f-anest-mode');const mode=(_anEl?_anEl.value:null)||'detalhe';
  const ANEST_COLORS={
    'Geral':'#FDD306','Raqui + Sedação':'#6f7378','Raqui':'#e8a838',
    'Raqui + Geral':'#c07a10','Raqui + Bloqueio':'#b06000',
    'Geral + Bloqueio':'#c8a800','Geral + Local':'#a08800','Geral + Sedação':'#906800',
    'Sedação':'#ff6b6b','Sedação + Local':'#cc3030','Sedação Combinada':'#cc4444','Sedação + Bloqueio':'#aa2020',
    'Local / Bloqueio':'#c084fc','Local':'#a060e0','Bloqueio':'#8040c8','Outros':'#4a4547'
  };
  const activeKey=crossFilters['ANESTESIA'];
  const counts={};
  d.forEach(r=>{const a=normAnest(r.ANESTESIA,mode);if(a)counts[a]=(counts[a]||0)+1;});
  if(activeKey&&activeKey.size){[...activeKey].forEach(v=>{if(!counts[v])activeKey.delete(v);});if(!activeKey.size){delete crossFilters['ANESTESIA'];renderChips();}}
  const total=Object.values(counts).reduce((s,v)=>s+v,0);
  if(!total)return;
  const container=document.getElementById('chart-anestesia');
  if(!container)return;
  const W=container.offsetWidth-4||380,H=container.offsetHeight-4||166;
  const items=Object.entries(counts).sort((a,b)=>b[1]-a[1]).map(([k,v])=>({label:k,value:v,color:ANEST_COLORS[k]||'#4a4547',area:(v/total)*W*H}));
  const rects=[];
  function scaleV(v){return(v/total)*W*H;}
  function worstA(row,w,h){
    const horiz=w>=h,ra=row.reduce((s,i)=>s+scaleV(i.value),0),side=horiz?ra/h:ra/w;
    let worst=0;row.forEach(i=>{const a=scaleV(i.value),b=a/side;worst=Math.max(worst,Math.max(side/b,b/side));});return worst;
  }
  function placeR(row,x,y,w,h){
    const horiz=w>=h,ra=row.reduce((s,i)=>s+scaleV(i.value),0),side=horiz?ra/h:ra/w;
    let pos=horiz?y:x;
    row.forEach(i=>{const a=scaleV(i.value),other=a/side;
      rects.push({label:i.label,value:i.value,color:i.color,area:i.area,x:horiz?x:pos,y:horiz?pos:y,w:horiz?side:other,h:horiz?other:side});pos+=other;});
    return horiz?[x+side,y,w-side,h]:[x,y+side,w,h-side];
  }
  function sqfy(its,row,x,y,w,h){
    if(!its.length){if(row.length)placeR(row,x,y,w,h);return;}
    if(!row.length){sqfy(its.slice(1),[its[0]],x,y,w,h);return;}
    const ww=worstA([...row,its[0]],w,h),wo=worstA(row,w,h);
    if(ww<=wo){sqfy(its.slice(1),[...row,its[0]],x,y,w,h);}
    else{const[nx,ny,nw,nh]=placeR(row,x,y,w,h);sqfy(its,[],nx,ny,nw,nh);}
  }
  sqfy(items,[],0,0,W,H);
  const GAP=3;let out='';
  rects.forEach(r=>{
    const dim=activeKey&&activeKey.size&&!activeKey.has(r.label)?'opacity:0.22':'opacity:1';
    const rw=Math.max(0,r.w-GAP),rh=Math.max(0,r.h-GAP);
    const pct=total?(r.value/total*100).toFixed(1)+'%':'';
    const fs=rw>100&&rh>40?13:rw>60&&rh>28?10:8;
    const showSub=rw>75&&rh>42;
    out+=`<div onclick="setCrossFilter('ANESTESIA','${r.label.replace(/'/g,"\\'")}')" style="position:absolute;left:${r.x}px;top:${r.y}px;width:${rw}px;height:${rh}px;background:${r.color};border-radius:2px;cursor:pointer;display:flex;flex-direction:column;align-items:center;justify-content:center;overflow:hidden;${dim};transition:opacity .2s;box-sizing:border-box;border:2px solid #231f20">
      <span style="font-family:'Roboto Condensed',sans-serif;font-weight:700;font-size:${fs}px;color:#231f20;line-height:1.2;text-align:center;padding:0 3px">${r.label}</span>
      ${showSub?`<span style="font-family:'Roboto Mono',monospace;font-size:${fs-2}px;color:#231f20;opacity:0.85;line-height:1.4">${r.value}&nbsp;·&nbsp;${pct}</span>`:''}
    </div>`;
  });
  container.innerHTML=out;
}

function renderASA(d){
  d=d||getActiveData();
  const activeASA=crossFilters['ASA_NORM'];
  var _asaEl=document.getElementById('f-asa-mode');const asaMode=(_asaEl?_asaEl.value:null)||'consolidado';
  const counts={};
  d.forEach(r=>{const a=normASA(r.ASA,asaMode);if(a)counts[a]=(counts[a]||0)+1;});
  const total=Object.values(counts).reduce((s,v)=>s+v,0);
  if(!total)return;
  const ASA_COLORS={
    'ASA I':'#FDD306','ASA I E':'#c8a800',
    'ASA II':'#6f7378','ASA II E':'#4a4547',
    'ASA III':'#e8a838','ASA III E':'#c07a10',
    'ASA IV':'#ff6b6b','ASA IV E':'#cc2020',
    'ASA V':'#c084fc','ASA V E':'#8040c8'
  };
  const container=document.getElementById('chart-asa');
  if(!container)return;
  if(crossFilters['ASA_NORM']&&!counts[crossFilters['ASA_NORM']]){delete crossFilters['ASA_NORM'];renderChips();}
  const W=container.offsetWidth-4||380, H=container.offsetHeight-4||166;
  const items=Object.entries(counts).sort((a,b)=>b[1]-a[1]).map(([k,v])=>({label:k,value:v,color:ASA_COLORS[k]||'#888',area:(v/total)*W*H}));

  // Squarified treemap algorithm
  const rects=[];
  function scaleVal(v){return (v/total)*W*H;}
  function shortSide(row,sx,sy,sw,sh){
    const horiz=sw>=sh;
    const rowArea=row.reduce((s,i)=>s+scaleVal(i.value),0);
    return horiz?rowArea/sh:rowArea/sw;
  }
  function worstAspect(row,sx,sy,sw,sh){
    const horiz=sw>=sh;
    const rowArea=row.reduce((s,i)=>s+scaleVal(i.value),0);
    const side=horiz?rowArea/sh:rowArea/sw;
    let worst=0;
    row.forEach(i=>{
      const a=scaleVal(i.value);
      const b=a/side;
      worst=Math.max(worst,Math.max(side/b,b/side));
    });
    return worst;
  }
  function placeRow(row,x,y,w,h){
    const horiz=w>=h;
    const rowArea=row.reduce((s,i)=>s+scaleVal(i.value),0);
    const side=horiz?rowArea/h:rowArea/w;
    let pos=horiz?y:x;
    row.forEach(i=>{
      const a=scaleVal(i.value);
      const other=a/side;
      rects.push({label:i.label,value:i.value,color:i.color,area:i.area,x:horiz?x:pos,y:horiz?pos:y,w:horiz?side:other,h:horiz?other:side});
      pos+=other;
    });
    return horiz?[x+side,y,w-side,h]:[x,y+side,w,h-side];
  }
  function squarify(its,row,x,y,w,h){
    if(!its.length){if(row.length)placeRow(row,x,y,w,h);return;}
    if(!row.length){squarify(its.slice(1),[its[0]],x,y,w,h);return;}
    const worstWith=worstAspect([...row,its[0]],x,y,w,h);
    const worstWithout=worstAspect(row,x,y,w,h);
    if(worstWith<=worstWithout){
      squarify(its.slice(1),[...row,its[0]],x,y,w,h);
    } else {
      const [nx,ny,nw,nh]=placeRow(row,x,y,w,h);
      squarify(its,[],nx,ny,nw,nh);
    }
  }
  squarify(items,[],0,0,W,H);

  const GAP=3;
  let out='';
  rects.forEach(r=>{
    const dim=activeASA&&activeASA.size&&!activeASA.has(r.label)?'opacity:0.22':'opacity:1';
    const rw=Math.max(0,r.w-GAP), rh=Math.max(0,r.h-GAP);
    const pct=total?(r.value/total*100).toFixed(1)+'%':'';
    const bigFont=rw>90&&rh>40?14:rw>55&&rh>30?11:9;
    const subFont=bigFont>11?11:9;
    const showSub=rw>70&&rh>44;
    out+=`<div onclick="setCrossFilter('ASA_NORM','${r.label}')" style="position:absolute;left:${r.x}px;top:${r.y}px;width:${rw}px;height:${rh}px;background:${r.color};border-radius:2px;cursor:pointer;display:flex;flex-direction:column;align-items:center;justify-content:center;overflow:hidden;${dim};transition:opacity .2s;box-sizing:border-box;border:2px solid #231f20">
      <span style="font-family:'Roboto Condensed',sans-serif;font-weight:700;font-size:${bigFont}px;color:#231f20;line-height:1.2;text-align:center">${r.label}</span>
      ${showSub?`<span style="font-family:'Roboto Mono',monospace;font-size:${subFont}px;color:#231f20;opacity:0.8;line-height:1.4">${r.value}&nbsp;·&nbsp;${pct}</span>`:''}
    </div>`;
  });
  container.innerHTML=out;
}


// ── Mobile: collapsible filters ─────────────────────────────
function toggleFilters(){
  const col=document.getElementById('filters-collapsible');
  const btn=document.getElementById('filter-toggle');
  col.classList.toggle('collapsed');
  btn.classList.toggle('open',!col.classList.contains('collapsed'));
}

function updateFilterBadge(){
  const active=[
    getChecked('ms-ano').length < document.querySelectorAll('#ms-ano-dd input:not(#ms-ano-all)').length,
    getChecked('ms-mes').length < document.querySelectorAll('#ms-mes-dd input:not(#ms-mes-all)').length,
    !!drpStart,
    !!document.getElementById('g-sala').value,
    !!document.getElementById('g-esp').value,
    !!document.getElementById('g-pri').value,
    !!document.getElementById('g-1cir').value,
    !!document.getElementById('g-fds').value,
  ].filter(Boolean).length;
  const badge=document.getElementById('ftb-count');
  badge.style.display=active?'inline':'none';
  badge.textContent=active;
}

// ── Treemap resize observer ──────────────────────────────────
let resizeTimer;
window.addEventListener('resize',()=>{
  clearTimeout(resizeTimer);
  resizeTimer=setTimeout(()=>{ renderASA(); renderAnestesia(); },200);
});

// ── Auto-expand filters on desktop ──────────────────────────
function initFiltersVisibility(){
  if(window.innerWidth>900){
    document.getElementById('filters-collapsible').classList.remove('collapsed');
  }
}

window.addEventListener('DOMContentLoaded',init);
window.addEventListener('DOMContentLoaded',initFiltersVisibility);
</script>
