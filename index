<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Produção Cirúrgica — HRR</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<link href="https://fonts.googleapis.com/css2?family=Roboto+Condensed:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Roboto+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{--bg:#231f20;--bg2:#2a2627;--bg3:#332e30;--border:#4a4547;--accent:#FDD306;--accent2:#e8c400;--accent3:#ff6b6b;--accent4:#ffd166;--text:#f0ece8;--muted:#6f7378;--card:#2d292a;}
*{box-sizing:border-box;margin:0;padding:0}
body{background:var(--bg);color:var(--text);font-family:'Roboto Condensed',sans-serif;min-height:100vh;padding:0 0 40px}
.header{background:#231f20;border-bottom:2px solid var(--accent);padding:16px 32px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:100}
.header-left{display:flex;align-items:center;gap:20px}
/* EXIMIO logo */
.eximio-logo{display:flex;flex-direction:column;gap:4px}
.eximio-wordmark{display:flex;align-items:baseline;gap:1px;letter-spacing:6px;font-size:22px;font-weight:700;font-family:'Roboto Condensed',sans-serif;text-transform:uppercase}
.ex-plain{color:#f0ece8}
.ex-e{color:#FDD306;text-shadow:0 0 8px rgba(253,211,6,0.4)}
.ex-i{color:#FDD306;text-shadow:0 0 8px rgba(253,211,6,0.4)}
.ex-i2{color:#FDD306;text-shadow:0 0 8px rgba(253,211,6,0.4)}
.ex-o{color:#FDD306;text-shadow:0 0 8px rgba(253,211,6,0.4)}
.eximio-tag{font-size:9px;font-weight:400;letter-spacing:1.5px;color:#6f7378;text-transform:lowercase;font-family:'Roboto Condensed',sans-serif;background:#FDD306;color:#231f20;padding:1px 6px;display:inline-block;font-weight:600}
.header-divider{width:1px;height:40px;background:var(--border);margin:0 4px}
.header h1{font-size:17px;font-weight:600;letter-spacing:0.5px;font-family:'Roboto Condensed',sans-serif}
.header h1 span{color:var(--accent)}
.header-sub{font-size:10px;color:var(--muted);font-family:'Roboto Mono',monospace;margin-top:2px;letter-spacing:0.5px}
.badge{background:rgba(253,211,6,0.1);border:1px solid rgba(253,211,6,0.4);color:var(--accent);font-size:11px;font-family:'Roboto Mono',monospace;padding:4px 10px;border-radius:4px;font-weight:600}
/* ── filters bar ── */
.filters-bar{background:var(--bg2);border-bottom:1px solid var(--border);padding:14px 32px;display:flex;align-items:center;gap:16px;flex-wrap:wrap}
.filters-bar label{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:1px;font-family:'Roboto Mono',monospace;margin-right:6px;white-space:nowrap}
.filters-bar select{background:var(--bg3);border:1px solid var(--border);color:var(--text);padding:6px 12px;border-radius:3px;font-family:'Roboto Condensed',sans-serif;font-size:13px;cursor:pointer;outline:none;transition:border-color .2s}
.filters-bar select:hover,.filters-bar select:focus{border-color:var(--accent)}
.filter-group{display:flex;align-items:center}
.reset-btn{background:transparent;border:1px solid var(--border);color:var(--muted);padding:6px 14px;border-radius:3px;font-size:12px;cursor:pointer;transition:all .2s;white-space:nowrap}
.reset-btn:hover{border-color:var(--accent3);color:var(--accent3)}
.total-badge{font-family:'Roboto Mono',monospace;font-size:12px;color:#231f20;background:var(--accent);border:1px solid var(--accent2);padding:4px 14px;border-radius:4px;white-space:nowrap;font-weight:700}
/* ── multi-select dropdown (ano & mês) ── */
.ms-wrap{position:relative;display:inline-block}
.ms-btn{background:var(--bg3);border:1px solid var(--border);color:var(--text);padding:6px 28px 6px 12px;border-radius:3px;font-size:13px;cursor:pointer;outline:none;transition:border-color .2s;white-space:nowrap;min-width:100px;text-align:left;position:relative;font-family:'Roboto Condensed',sans-serif}
.ms-btn::after{content:"▾";position:absolute;right:8px;top:50%;transform:translateY(-50%);color:var(--muted);font-size:10px}
.ms-btn:hover,.ms-btn.open{border-color:var(--accent)}
.ms-dropdown{display:none;position:absolute;top:calc(100% + 4px);left:0;background:var(--bg3);border:1px solid var(--accent);border-radius:4px;padding:8px 0;z-index:300;min-width:160px;box-shadow:0 8px 24px rgba(0,0,0,.6)}
.ms-dropdown.show{display:block}
.ms-dropdown label{display:flex;align-items:center;gap:8px;padding:5px 14px;cursor:pointer;font-size:12px;color:var(--text);transition:background .15s;white-space:nowrap}
.ms-dropdown label:hover{background:rgba(253,211,6,.08)}
.ms-dropdown input[type=checkbox]{accent-color:var(--accent);width:13px;height:13px;cursor:pointer}
.ms-select-all{border-bottom:1px solid var(--border);margin-bottom:4px;padding-bottom:4px}
/* ── date range picker ── */
.drp-wrap{position:relative;display:inline-block}
.drp-btn{background:var(--bg3);border:1px solid var(--border);color:var(--text);padding:6px 12px 6px 32px;border-radius:3px;font-size:12px;cursor:pointer;outline:none;transition:border-color .2s;white-space:nowrap;min-width:175px;text-align:left;position:relative;font-family:'Roboto Mono',monospace}
.drp-btn::before{content:"📅";position:absolute;left:9px;top:50%;transform:translateY(-50%);font-size:12px}
.drp-btn:hover,.drp-btn.open{border-color:var(--accent)}
.drp-btn.active{border-color:var(--accent);color:var(--accent);background:rgba(253,211,6,.08)}
.drp-panel{display:none;position:absolute;top:calc(100% + 4px);left:0;background:var(--bg3);border:1px solid var(--accent);border-radius:4px;padding:16px;z-index:300;box-shadow:0 12px 32px rgba(0,0,0,.7);min-width:580px}
.drp-panel.show{display:flex;flex-direction:column;gap:12px}
.drp-calendars{display:flex;gap:20px}
.drp-cal{flex:1}
.drp-cal-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px}
.drp-cal-header button{background:none;border:1px solid var(--border);color:var(--text);width:26px;height:26px;border-radius:3px;cursor:pointer;font-size:14px;display:flex;align-items:center;justify-content:center;transition:border-color .15s}
.drp-cal-header button:hover{border-color:var(--accent);color:var(--accent)}
.drp-cal-title{font-size:12px;font-weight:600;color:var(--text);font-family:'Roboto Mono',monospace;text-align:center}
.drp-weekdays{display:grid;grid-template-columns:repeat(7,1fr);gap:2px;margin-bottom:4px}
.drp-weekdays span{font-size:9px;color:var(--muted);text-align:center;padding:2px 0;font-family:'Roboto Mono',monospace;text-transform:uppercase}
.drp-days{display:grid;grid-template-columns:repeat(7,1fr);gap:2px}
.drp-day{height:28px;border-radius:3px;cursor:pointer;font-size:11px;font-family:'Roboto Mono',monospace;display:flex;align-items:center;justify-content:center;transition:all .15s;color:var(--text);background:transparent;border:none}
.drp-day:hover:not(.drp-empty):not(.drp-disabled){background:rgba(253,211,6,.15);color:var(--accent)}
.drp-day.drp-empty{cursor:default}
.drp-day.drp-disabled{color:var(--muted);opacity:.4;cursor:default}
.drp-day.drp-start,.drp-day.drp-end{background:var(--accent)!important;color:#231f20!important;font-weight:700;border-radius:6px}
.drp-day.drp-in-range{background:rgba(0,212,255,.12);border-radius:0}
.drp-day.drp-start.drp-in-range{border-radius:6px 0 0 6px}
.drp-day.drp-end.drp-in-range{border-radius:0 6px 6px 0}
.drp-day.drp-start.drp-end{border-radius:6px!important}
.drp-footer{display:flex;align-items:center;justify-content:space-between;padding-top:8px;border-top:1px solid var(--border)}
.drp-range-display{font-size:11px;font-family:'Roboto Mono',monospace;color:var(--muted)}
.drp-range-display span{color:var(--accent)}
.drp-actions{display:flex;gap:8px}
.drp-actions button{padding:5px 14px;border-radius:3px;font-size:11px;cursor:pointer;font-family:'Roboto Condensed',sans-serif;border:1px solid var(--border);transition:all .15s}
.drp-apply{background:var(--accent);color:#231f20;font-weight:700;border-color:var(--accent)}
.drp-apply:hover{opacity:.85}
.drp-clear-btn{background:transparent;color:var(--muted)}
.drp-clear-btn:hover{border-color:var(--accent3);color:var(--accent3)}
/* ── chips bar ── */
.chips-bar{background:rgba(0,212,255,.04);border-bottom:1px solid var(--border);padding:10px 32px;display:none;align-items:center;gap:8px;flex-wrap:wrap}
.chips-bar.visible{display:flex}
.chips-label{font-size:10px;color:var(--accent);text-transform:uppercase;letter-spacing:1px;font-family:'Roboto Mono',monospace;margin-right:4px;white-space:nowrap}
.chip{display:flex;align-items:center;gap:6px;background:rgba(0,212,255,.12);border:1px solid rgba(253,211,6,.4);color:var(--accent);font-size:11px;padding:3px 10px;border-radius:3px;animation:chipIn .2s ease}
.chip-dim{color:var(--muted);font-size:10px;font-family:'Roboto Mono',monospace;margin-right:2px}
.chip button{background:none;border:none;color:var(--accent);cursor:pointer;font-size:14px;line-height:1;padding:0;opacity:.7;transition:opacity .15s}
.chip button:hover{opacity:1}
.chip-clear-all{background:transparent;border:1px solid var(--border);color:var(--muted);padding:3px 10px;border-radius:3px;font-size:11px;cursor:pointer;transition:all .2s;margin-left:4px}
.chip-clear-all:hover{border-color:var(--accent3);color:var(--accent3)}
@keyframes chipIn{from{opacity:0;transform:scale(.9)}to{opacity:1;transform:scale(1)}}
/* ── KPIs ── */
.kpi-row{display:grid;grid-template-columns:repeat(5,1fr);gap:16px;padding:24px 32px 0}
.kpi-card{background:var(--card);border:1px solid var(--border);border-radius:4px;padding:18px 20px;position:relative;overflow:hidden;transition:border-color .2s,transform .2s}
.kpi-card:hover{border-color:rgba(253,211,6,.4);transform:translateY(-2px)}
.kpi-card::before{content:"";position:absolute;top:0;left:0;right:0;height:2px;background:var(--kpi-color,var(--accent))}
.kpi-label{font-size:10px;text-transform:uppercase;letter-spacing:1.5px;color:var(--muted);font-family:'Roboto Mono',monospace;margin-bottom:8px}
.kpi-value{font-size:32px;font-weight:700;color:var(--kpi-color,var(--accent));font-family:'Roboto Mono',monospace;line-height:1}
.kpi-sub{font-size:11px;color:var(--muted);margin-top:6px}
/* ── chart grid ── */
.charts-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;padding:20px 32px}
.charts-grid .full-width{grid-column:1/-1}
.chart-card{background:var(--card);border:1px solid var(--border);border-radius:4px;padding:20px 22px;position:relative;overflow:hidden;transition:border-color .2s}
.chart-card:hover{border-color:rgba(253,211,6,.25)}
.chart-card.has-filter{border-color:rgba(253,211,6,.6);box-shadow:0 0 16px rgba(0,212,255,.1)}
.chart-header{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:16px;gap:10px;flex-wrap:wrap}
.chart-title{font-size:16px;font-weight:700;letter-spacing:.3px;color:var(--text);text-transform:uppercase}
.chart-subtitle{font-size:10px;color:var(--muted);margin-top:2px;font-family:'Roboto Mono',monospace}
.chart-filter select{background:var(--bg3);border:1px solid var(--border);color:var(--text);padding:4px 8px;border-radius:3px;font-size:11px;cursor:pointer;outline:none}
.chart-filter select:hover{border-color:var(--accent)}
.section-label{padding:8px 32px 0;font-size:10px;text-transform:uppercase;letter-spacing:3px;color:var(--accent);font-family:'Roboto Condensed',sans-serif;font-weight:700;border-left:3px solid var(--accent);padding-left:16px;margin-left:32px}
.charts-grid-3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:20px;padding:0 32px}
.footer{padding:20px 32px 0;text-align:center;font-size:10px;color:var(--muted);font-family:'Roboto Mono',monospace}
canvas{cursor:pointer}
::-webkit-scrollbar{width:6px;height:6px}::-webkit-scrollbar-track{background:var(--bg)}::-webkit-scrollbar-thumb{background:#4a4547;border-radius:3px}

/* ═══════════════════════════════════════════════════════════
   RESPONSIVE — MOBILE & TABLET
═══════════════════════════════════════════════════════════ */
.filter-toggle-btn {
  display:none;
  width:100%;background:var(--bg3);border:none;border-bottom:2px solid var(--accent);
  color:var(--text);padding:12px 20px;text-align:left;cursor:pointer;
  font-family:'Roboto Condensed',sans-serif;font-size:13px;font-weight:600;
  letter-spacing:1px;text-transform:uppercase;
  display:flex;align-items:center;justify-content:space-between;
}
.filter-toggle-btn .ftb-badge {
  background:var(--accent);color:#231f20;border-radius:3px;
  padding:2px 8px;font-size:11px;font-weight:700;
}
.filter-toggle-btn .ftb-arrow { transition:transform .25s; font-size:12px; }
.filter-toggle-btn.open .ftb-arrow { transform:rotate(180deg); }
.filters-collapsible { transition:max-height .3s ease,opacity .3s ease;overflow:hidden; }
.filters-collapsible.collapsed { max-height:0!important;opacity:0;pointer-events:none; }

@media(max-width:900px){
  .filter-toggle-btn{display:flex}
  .filters-collapsible{max-height:600px;opacity:1}
  .filters-bar{flex-direction:column;align-items:stretch;gap:10px;padding:14px 16px}
  .filter-group{flex-direction:row;align-items:center;gap:8px}
  .filter-group label{min-width:110px;margin-right:0}
  .filter-group select,.ms-btn,.drp-btn{flex:1;width:100%;min-width:0}
  .reset-btn,.total-badge{align-self:center}
  .drp-panel{min-width:unset;width:calc(100vw - 32px);left:0;right:0}
}

@media(max-width:768px){
  /* Header */
  .header{padding:12px 16px;flex-wrap:wrap;gap:8px;position:relative}
  .eximio-wordmark{font-size:15px;letter-spacing:3px}
  .eximio-tag{font-size:8px}
  .header-divider{display:none}
  .header h1{font-size:13px}
  .header-sub{font-size:9px}
  .badge{font-size:10px;padding:3px 8px}

  /* Grids → single column */
  .kpi-row{grid-template-columns:1fr 1fr;gap:10px;padding:12px 16px 0}
  .kpi-value{font-size:26px}
  .kpi-label{font-size:9px}
  .charts-grid{grid-template-columns:1fr;padding:12px 16px;gap:12px}
  .charts-grid .full-width{grid-column:1}
  .charts-grid-3{grid-template-columns:1fr;gap:12px;padding:0 16px}
  .section-label{padding:8px 16px 0;margin-left:16px;font-size:9px}
  .chips-bar{padding:8px 16px}
  .footer{padding:12px 16px 0;font-size:9px}

  /* Calendar: single column on mobile */
  .drp-calendars{flex-direction:column;gap:8px}
  .drp-cal:last-child{display:none} /* hide 2nd calendar on small screens */
  .drp-panel{padding:12px}

  /* Chart cards */
  .chart-card{padding:14px 14px}
  .chart-title{font-size:13px}

  /* Canvas heights — taller for single column */
  canvas#chart-porte,canvas#chart-prioridade{height:200px!important}
  canvas#chart-sexo,canvas#chart-faixa{height:220px!important}

  /* Treemaps */
  #chart-asa{height:160px!important}
  #chart-anestesia{height:180px!important}

  /* Filters stacked */
  .filter-group{flex-direction:column;align-items:stretch}
  .filter-group label{min-width:unset;margin-bottom:2px}
}

@media(max-width:480px){
  .kpi-row{grid-template-columns:1fr 1fr}
  .kpi-value{font-size:22px}
  .eximio-wordmark{font-size:13px;letter-spacing:2px}
  canvas#chart-esp,canvas#chart-cir,canvas#chart-anest{height:340px!important}
}


/* Scrollable wide charts on mobile */
.chart-scroll-wrap{width:100%;overflow-x:auto;-webkit-overflow-scrolling:touch;padding-bottom:6px}
.chart-scroll-wrap::-webkit-scrollbar{height:4px}
.chart-scroll-wrap::-webkit-scrollbar-thumb{background:#FDD306;border-radius:2px}
.chart-scroll-inner{position:relative}
.chart-scroll-inner canvas{position:absolute;top:0;left:0;width:100%!important;height:100%!important}
@media(max-width:768px){
  .chart-scroll-wrap{border:1px solid rgba(253,211,6,0.2);border-radius:3px;}
}
</style>
</head>
<body>
<div class="header">
  <div class="header-left">
    <div class="eximio-logo">
      <div class="eximio-wordmark">
        <span class="ex-e">E</span><span class="ex-plain">X</span><span class="ex-i">I</span><span class="ex-plain">M</span><span class="ex-i2">I</span><span class="ex-o">O</span>
      </div>
      <div class="eximio-tag">ecossistema de gestão hospitalar</div>
    </div>
    <div class="header-divider"></div>
    <div>
      <h1>Produção Cirúrgica — <span>HRR</span></h1>
      <div class="header-sub">HOSPITAL REGIONAL DE REGISTRO · CENTRO CIRÚRGICO</div>
    </div>
  </div>
  <div class="badge" id="data-range-badge">Carregando...</div>
</div>

<div class="filter-toggle-btn" id="filter-toggle" onclick="toggleFilters()">
  <span>⚙ Filtros <span id="ftb-count" class="ftb-badge" style="display:none">0</span></span>
  <span class="ftb-arrow">▾</span>
</div>
<div class="filters-collapsible collapsed" id="filters-collapsible">
<div class="filters-bar">
  <!-- Ano multi-select -->
  <span class="filter-group"><label>Ano</label>
    <div class="ms-wrap" id="ms-ano-wrap">
      <button class="ms-btn" id="ms-ano-btn" onclick="toggleMsDd(event,'ms-ano-dd')">Todos os anos</button>
      <div class="ms-dropdown" id="ms-ano-dd">
        <label class="ms-select-all"><input type="checkbox" id="ms-ano-all" onchange="toggleAllAno(this)"><span>Selecionar todos</span></label>
      </div>
    </div>
  </span>
  <!-- Mês multi-select -->
  <span class="filter-group"><label>Mês</label>
    <div class="ms-wrap" id="ms-mes-wrap">
      <button class="ms-btn" id="ms-mes-btn" onclick="toggleMsDd(event,'ms-mes-dd')">Todos os meses</button>
      <div class="ms-dropdown" id="ms-mes-dd">
        <label class="ms-select-all"><input type="checkbox" id="ms-mes-all" onchange="toggleAllMes(this)"><span>Selecionar todos</span></label>
      </div>
    </div>
  </span>
  <!-- Date range picker -->
  <span class="filter-group"><label>Data</label>
    <div class="drp-wrap" id="drp-wrap">
      <button class="drp-btn" id="drp-btn" onclick="toggleDrp(event)">Todas as datas</button>
      <div class="drp-panel" id="drp-panel" onclick="event.stopPropagation()">
        <div class="drp-calendars" onmousemove="drpHoverMove(event)" onmouseleave="drpHoverLeave()">
          <div class="drp-cal" id="drp-cal-left"></div>
          <div class="drp-cal" id="drp-cal-right"></div>
        </div>
        <div class="drp-footer">
          <div class="drp-range-display" id="drp-range-display">Clique para selecionar data inicial</div>
          <div class="drp-actions">
            <button class="drp-actions drp-clear-btn" onclick="clearDateRange()">Limpar</button>
            <button class="drp-actions drp-apply" onclick="applyDateRange()">Aplicar</button>
          </div>
        </div>
      </div>
    </div>
  </span>
  <!-- Other filters -->
  <span class="filter-group"><label>Sala</label><select id="g-sala" onchange="applyGlobalFilters()"><option value="">Todas</option></select></span>
  <span class="filter-group"><label>Especialidade</label><select id="g-esp" onchange="applyGlobalFilters()"><option value="">Todas</option></select></span>
  <span class="filter-group"><label>Prioridade</label><select id="g-pri" onchange="applyGlobalFilters()"><option value="">Todas</option></select></span>
  <span class="filter-group"><label>1ª Cirurgia</label><select id="g-1cir" onchange="applyGlobalFilters()"><option value="">Todas</option><option value="1ª Cirurgia">Somente 1ª</option></select></span>
  <span class="filter-group"><label>Final de Semana</label><select id="g-fds" onchange="applyGlobalFilters()"><option value="">Todos</option><option value="Sim">Sim</option><option value="Não">Não</option></select></span>
  <button class="reset-btn" onclick="resetFilters()">↺ Limpar filtros</button>
  <div class="total-badge" id="total-count">— cirurgias</div>
</div>
</div>

<div class="chips-bar" id="chips-bar">
  <span class="chips-label">⬡ Filtros interativos:</span>
  <div id="chips-container" style="display:flex;gap:8px;flex-wrap:wrap;align-items:center"></div>
  <button class="chip-clear-all" onclick="clearCrossFilters()">✕ Limpar todos</button>
</div>

<div class="kpi-row">
  <div class="kpi-card" style="--kpi-color:#FDD306"><div class="kpi-label">Total Cirurgias</div><div class="kpi-value" id="kpi-total">—</div><div class="kpi-sub">período selecionado</div></div>
