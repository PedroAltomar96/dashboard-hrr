// ── Inline Data Labels Plugin ──────────────────────────────────
Chart.register({
  id:'hrr_datalabels',
  afterDatasetsDraw(chart){
    const ctx=chart.ctx,type=chart.config.type;
    var _o=chart.config.options||{},_sc=_o.scales||{};const stacked=!!(_sc.x&&_sc.x.stacked)||!!(_sc.y&&_sc.y.stacked);
    ctx.save();var _fs=window.innerWidth<768?8:10;ctx.font='600 '+_fs+'px Roboto Mono, monospace';
    chart.data.datasets.forEach((ds,i)=>{
      const meta=chart.getDatasetMeta(i);
      if(meta.hidden||meta.type==='line')return;
      meta.data.forEach((el,j)=>{
        const raw=ds.data[j];
        if(!raw)return;
        if(type==='doughnut'||type==='pie'){
          const span=el.endAngle-el.startAngle;
          if(span<0.25)return;
          const total=ds.data.reduce((a,b)=>a+(b||0),0);
          const mid=(el.startAngle+el.endAngle)/2,r=(el.innerRadius+el.outerRadius)/2;
          ctx.fillStyle='rgba(35,31,32,0.92)';ctx.textAlign='center';ctx.textBaseline='middle';
          ctx.fillText((raw/total*100).toFixed(1)+'%',el.x+r*Math.cos(mid),el.y+r*Math.sin(mid));
        } else if(type==='bar'){
          const horiz=(chart.config.options&&chart.config.options.indexAxis)==='y';
          if(stacked){
            const sz=horiz?(el.x-el.base):(el.base-el.y);
            if(sz<16)return;
            ctx.fillStyle='rgba(35,31,32,0.92)';ctx.textAlign='center';ctx.textBaseline='middle';
            ctx.fillText(raw.toFixed(1)+'%',horiz?(el.base+el.x)/2:el.x,horiz?el.y:(el.base+el.y)/2);
          } else if(horiz){
            const lbl=raw.toLocaleString('pt-BR');
            const tw=ctx.measureText(lbl).width;
            const bw=Math.max(0,el.x-el.base);
            if(bw<tw+6)return; // bar too narrow — skip label
            ctx.fillStyle='rgba(35,31,32,0.92)';
            ctx.textAlign='right';ctx.textBaseline='middle';
            ctx.fillText(lbl,el.x-5,el.y);
          } else {
            ctx.fillStyle='rgba(226,232,240,0.88)';ctx.textAlign='center';ctx.textBaseline='bottom';
            ctx.fillText(raw.toLocaleString('pt-BR'),el.x,el.y-3);
          }
        }
      });
    });
    ctx.restore();
  }
});

